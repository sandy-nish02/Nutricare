<%@ page contentType="text/html;charset=UTF-8" %>
<%@ include file="includes/header.jsp" %>
<section class="card receipt"><div class="page-heading"><div><p class="eyebrow">NutriCare billing</p><h1>${payment.status == 'VERIFIED' ? 'Payment receipt' : 'Payment invoice'}</h1></div><button class="button print-hide" type="button" onclick="window.print()">Print</button></div>
    <div class="grid grid-2"><div><p class="muted">Receipt / record number</p><h2>NC-${payment.id}</h2><p><strong>Patient</strong><br><c:out value="${payment.patient_name}"/></p><p><strong>Transaction reference</strong><br><c:out value="${payment.transaction_ref}"/></p><c:if test="${not empty payment.appointment_id}"><p><strong>Service</strong><br>Appointment #<c:out value="${payment.appointment_id}"/><c:if test="${not empty payment.appointment_time}"> on <fmt:formatDate value="${payment.appointment_time}" pattern="dd MMM yyyy, h:mm a"/></c:if></p></c:if></div><div><p class="muted">Amount</p><h1>LKR <fmt:formatNumber value="${payment.amount}" minFractionDigits="2" maxFractionDigits="2"/></h1><p><strong>Status</strong><br><span class="badge badge-${payment.status}"><c:out value="${payment.status}"/></span></p><p><strong>Method</strong><br><c:out value="${payment.method}"/></p></div></div>
    <hr><p class="muted">Submitted: <fmt:formatDate value="${payment.submitted_at}" pattern="dd MMM yyyy, h:mm a"/><c:if test="${not empty payment.verified_at}"><br>Reviewed: <fmt:formatDate value="${payment.verified_at}" pattern="dd MMM yyyy, h:mm a"/> by <c:out value="${payment.verifier_name}"/></c:if></p>
</section>
<%@ include file="includes/footer.jsp" %>
